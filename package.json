{
  "name": "semantic-delta-extension",
  "displayName": "semantic-delta-extension",
  "description": "Detect semantic conflicts between SQL queries",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ryukanchi/semantic-delta-extension.git"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "dependencies": {
    "semantic-delta-detector": "file:vendor/semantic-delta-detector-1.1.0.tgz"
  },
  "activationEvents": [
    "onCommand:semantic-delta.compareSql",
    "onCommand:semantic-delta.runDemo",
    "onCommand:semantic-delta.runExample"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "semantic-delta.compareSql",
        "title": "Semantic Delta: Compare SQL"
      },
      {
        "command": "semantic-delta.runDemo",
        "title": "Semantic Delta: Run Demo"
      },
      {
        "command": "semantic-delta.runExample",
        "title": "Semantic Delta: Run Example"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "verify:engine": "node scripts/verify-engine.mjs",
    "preinstall": "npm run verify:engine",
    "compile": "npm run verify:engine && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node --test out/test/*.test.js",
    "pretest:extension": "npm run compile && npm run lint",
    "test:extension": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.110.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
